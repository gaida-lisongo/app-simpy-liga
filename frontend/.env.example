# Copier ce fichier en .env et remplir les valeurs.
# Côté serveur SvelteKit uniquement ($env/static/private) — JAMAIS exposer au navigateur.

# URL interne du backend FastAPI (joignable par le serveur SvelteKit).
# Doit correspondre au port du process pm2 "app-simpy-liga" (voir `pm2 describe app-simpy-liga`).
API_INTERNAL_URL=http://127.0.0.1:4004

# Secret partagé avec le backend (INTERNAL_API_TOKEN). Doit être une chaîne aléatoire
# forte (≥ 32 caractères) et identique au backend. Régénérer en cas de fuite.
INTERNAL_API_TOKEN=change-me-in-production-min-32-chars-random

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=