{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "frontend/.opencode/skills"
    ]
  },
  "maxContextTokens": 40000,
  "command": {
    "plan-science": {
      "template": "Analyse cette anomalie ou feature backend et produis le plan dans memory-bank/science/activeContext.md : $ARGUMENTS",
      "description": "EINSTEIN — Planifier une correction scientifique backend",
      "agent": "einstein"
    },
    "patch": {
      "template": "Exécute le plan dans memory-bank/science/activeContext.md. Si absent, dis-le. $ARGUMENTS",
      "description": "PATCHER — Corriger le backend selon le plan EINSTEIN",
      "agent": "patcher"
    },
    "audit": {
      "template": "Lance l'audit sécurité sur le périmètre : $ARGUMENTS. Écris le rapport dans memory-bank/security/findings/.",
      "description": "SHEERLOCK → SENTINEL — Planifier et exécuter l'audit sécurité",
      "agent": "sheerlock",
      "subtask": true
    },
    "secure": {
      "template": "Applique les patches du dernier rapport dans memory-bank/security/findings/. $ARGUMENTS",
      "description": "SENTINEL — Appliquer les correctifs de sécurité",
      "agent": "sentinel",
      "subtask": true
    },
    "status": {
      "template": "Lis memory-bank/shared/progress.md et dis-moi où en est le projet.",
      "description": "STATUS — Rapport d'avancement rapide (token minimal)",
      "agent": "status"
    }
  },
  "agent": {
    "superman": {
      "mode": "primary",
      "model": "openrouter/minimax/minimax-m2.7",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/agents/superman.md}",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow"
      },
      "description": "UI/UX — Planification features et corrections interface"
    },
    "builder": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/agents/builder.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "description": "UI/UX — Implémentation frontend Svelte 5"
    },
    "einstein": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/agents/einstein.md}",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      },
      "description": "Science — Planification corrections thermodynamiques backend"
    },
    "patcher": {
      "mode": "subagent",
      "model": "openrouter/qwen/qwen3.6-plus",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/agents/patcher.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "description": "Science — Correction backend physique et Monte-Carlo"
    },
    "sheerlock": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.1",
      "temperature": 0.3,
      "prompt": "{file:./.opencode/agents/sheerlock.md}",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow"
      },
      "description": "Sécurité — Planification et orchestration pentesting"
    },
    "sentinel": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.6-luna",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/agents/sentinel.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "description": "Sécurité — Exécution audit et patches sécurité"
    },
    "status": {
      "mode": "primary",
      "model": "openrouter/xiaomi/mimo-v2.5",
      "temperature": 0.0,
      "prompt": "{file:./.opencode/agents/status.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny"
      },
      "description": "Rapport d'avancement — lecture seule progress.md"
    }
  },
  "defaultAgent": "status"
}