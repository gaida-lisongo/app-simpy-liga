# Copier en `.env` et remplir. Variables lues par le backend (uvicorn / docker).
# Le frontend SvelteKit doit partager la même valeur de INTERNAL_API_TOKEN
# pour pouvoir franchir le middleware d'auth interne.

# Jeton partagé entre le backend et le proxy SvelteKit (/api-proxy).
# Régénérer une chaîne aléatoire forte (≥ 32 caractères) pour la production :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=change-me-min-32-chars-random

# URL publique du site (sans slash final) — utilisée pour appeler le webhook
# de notification email de fin de campagne et construire le lien du mail.
PUBLIC_BASE_URL=https://exemple.com

# Optionnel — pour overrides de config catalogue (laisser vide par défaut).
COOLPROP_REFPROP_PATH=